--install ollama
curl -fsSL https://ollama.com/install.sh | sh
ollama pull llama3.2:1b
ollama list
ollama run llama3.2:1b


---pull repo
git clone <REPO URL>
cd <folder name>


--Python, venv, dependencies
sudo dnf update -y
sudo dnf install python3.12 python3.12-pip -y
python3.12 -m venv .venv
source .venv/bin/activate
python -m pip install --upgrade pip
pip install -r requirements.txt


---create databse and admin
python manage.py makemigrations
python manage.py migrate
python manage.py createsuperuser


--create .env file set
OLLAMA_MODEL=llama3.2:1b
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=<domian>,<www.domain>


--gunicorn and nginx install and setup
gunicorn config.wsgi:application --bind 127.0.0.1:8080
sudo dnf install nginx -y
sudo nano /etc/nginx/conf.d/django.conf
sudo nano /etc/systemd/system/django.service
curl 127.0.0.1:8080


--Static files and permission
python manage.py collectstatic --noinput
sudo cp deployments/nginx.config /etc/nginx/conf.d/django-nb.conf   # or wherever it's linked
sudo nginx -t && sudo systemctl reload nginx
sudo systemctl restart django   # your gunicorn service
sudo chmod o+x /home/ec2-user


--LOGS and importat commands
sudo systemctl status ollama
sudo systemctl start nginx
sudo systemctl restart django
sudo tail -f /var/log/nginx/access.log


